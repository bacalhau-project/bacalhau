# Use the docker:dind image as the base image
FROM alpine:latest

# Set the working directory
WORKDIR /app

# Install curl and bash
RUN apk update && apk add --no-cache curl bash unzip

# Install Nats CLI
RUN set -eux; \
    machine_arch="$(uname -m)"; \
    case "$machine_arch" in \
        x86_64) nats_arch="amd64"; nats_sha256="728c562e8f59bacd5eb016a6db2664e343b79f3c6642ba03fb9fb1dce7a2bc40" ;; \
        aarch64) nats_arch="arm64"; nats_sha256="49d3157511e4f8d61bdee273b4ea5d19821c454b261fe18568e18254febb344f" ;; \
        *) echo "Unsupported architecture: $machine_arch" >&2; exit 1 ;; \
    esac; \
    nats_archive="nats-0.1.5-linux-${nats_arch}.zip"; \
    curl -fsSLO "https://github.com/nats-io/natscli/releases/download/v0.1.5/${nats_archive}"; \
    echo "${nats_sha256}  ${nats_archive}" | sha256sum -c -; \
    unzip -q "$nats_archive"; \
    mv "nats-0.1.5-linux-${nats_arch}/nats" /usr/local/bin/nats; \
    rm -rf "$nats_archive" "nats-0.1.5-linux-${nats_arch}"; \
    nats --version

# Install the ca-certificates package
RUN apk add --no-cache ca-certificates

# Copy a root ca into the image
COPY ./common_assets/certificates/generated_assets/bacalhau_test_root_ca.crt /usr/local/share/ca-certificates/bacalhau_test_root_ca.crt

# Update CA certificates
RUN update-ca-certificates

# Copy Tests Assets
RUN mkdir -p /bacalhau_integration_tests
COPY ./ /bacalhau_integration_tests

# Download and execute the Bash script from the given URL
COPY ./common_assets/bacalhau_bin /usr/local/bin/bacalhau
RUN chmod +x /usr/local/bin/bacalhau

# Install the MinIO CLI. dl.min.io stopped serving community builds (HTTP 410),
# so take the final release from the archived minio/mc GitHub repo.
RUN set -eux; \
    machine_arch="$(uname -m)"; \
    case "$machine_arch" in \
        x86_64) mc_arch="amd64"; mc_sha256="01f866e9c5f9b87c2b09116fa5d7c06695b106242d829a8bb32990c00312e891" ;; \
        aarch64) mc_arch="arm64"; mc_sha256="14c8c9616cfce4636add161304353244e8de383b2e2752c0e9dad01d4c27c12c" ;; \
        *) echo "Unsupported architecture: $machine_arch" >&2; exit 1 ;; \
    esac; \
    mc_release="RELEASE.2025-08-13T08-35-41Z"; \
    curl -fsSL -o /usr/local/bin/mc "https://github.com/minio/mc/releases/download/${mc_release}/mc.linux-${mc_arch}.${mc_release}"; \
    echo "${mc_sha256}  /usr/local/bin/mc" | sha256sum -c -; \
    chmod +x /usr/local/bin/mc; \
    mc --version
